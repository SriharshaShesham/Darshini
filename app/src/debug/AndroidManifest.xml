<?xml version="1.0" encoding="utf-8"?>
<!-- Debug variant: don't ship the branded launcher icon. Repoint to Android's stock default so the
     debug build is visually distinct from release. Overrides the raster mipmaps too (this replaces
     the resource reference, unlike an adaptive-icon res override which the launcher ignored). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:icon="@android:drawable/sym_def_app_icon"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        tools:replace="android:icon,android:roundIcon" />
</manifest>
